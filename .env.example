# Runtime
NODE_ENV=production
TZ=Asia/Shanghai
AIRADIO_API_HOST=0.0.0.0
AIRADIO_API_PORT=4177
AIRADIO_STORAGE_DIR=./server/storage

# Admin login. Change these before deployment.
AIRADIO_ADMIN_USER=admin
AIRADIO_ADMIN_PASSWORD=change-this-password

# Optional KuGou WeChat app credentials.
# Leave empty unless you operate KuGou login flows that require these values.
KUGOU_WX_APPID=
KUGOU_WX_LITE_APPID=
KUGOU_WX_SECRET=
KUGOU_WX_LITE_SECRET=
