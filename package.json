{
  "name": "star-voice-radio",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5176",
    "dev:api": "node server/dev-supervisor.js",
    "dev:api:once": "node server/index.js",
    "dev:full": "concurrently \"npm:dev:api\" \"npm:dev\"",
    "install:music-apis": "npm ci --prefix NeteaseCloudMusicApi --omit=dev --ignore-scripts && npm install --prefix QQMusicApi --omit=dev --ignore-scripts --package-lock=false --prefer-online --no-save https://registry.npmjs.org/cheerio/-/cheerio-1.0.0-rc.3.tgz",
    "install:suno-api": "npm ci --prefix suno-api && PLAYWRIGHT_BROWSERS_PATH=./suno-api/.playwright-browsers node suno-api/node_modules/rebrowser-playwright-core/cli.js install chromium",
    "build:suno-api": "npm run build --prefix suno-api",
    "start:suno-api": "node suno-api/node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3010",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@fontsource/noto-serif-sc": "^5.2.9",
    "@fontsource/zcool-xiaowei": "^5.2.8",
    "@vitejs/plugin-react": "^6.0.3",
    "axios": "^1.18.1",
    "better-sqlite3": "^12.11.1",
    "big-integer": "^1.6.52",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "node-forge": "^1.4.0",
    "pako": "^3.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "safe-decode-uri-component": "^1.2.1",
    "three": "^0.185.1",
    "url": "^0.11.4",
    "vite": "^8.1.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.0",
    "concurrently": "^10.0.3",
    "playwright-core": "^1.61.1",
    "sharp": "^0.35.3",
    "typescript": "^5.6.3",
    "vitest": "^4.1.9"
  }
}
